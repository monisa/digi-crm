APP_NAME="DigiFox Pro CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.digifoxprosolutions.com/api
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_crm
DB_USERNAME=u000000000_crmuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@digifoxprosolutions.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@digifoxprosolutions.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Angular app origin (same domain, so no CORS needed)
FRONTEND_URL=https://crm.digifoxprosolutions.com
# Login token lifetime ceiling in minutes (30 days)
SANCTUM_EXPIRATION=43200

# Sign in with Google (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=

# Printed on payslips
COMPANY_NAME="DIGIFOX PRO SOLUTIONS LLP"
COMPANY_ADDRESS="Kakkanad, Kochi, Kerala"
COMPANY_EMAIL=info@digifoxprosolutions.com

# Meta Lead Ads (developers.facebook.com -> app settings). Page tokens are entered in the CRM, not here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
